{
  "name": "Mantel",
  "short_name": "Mantel",
  "description": "The family's remote for the Mantel wall display: lists, calendar, meals, chores and notes.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#efeee9",
  "theme_color": "#246b5b",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Add to a list", "url": "/app#lists" },
    { "name": "Calendar", "url": "/app#calendar" },
    { "name": "Leave a note", "url": "/app#note" }
  ]
}
