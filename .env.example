# Copy to .env and fill in. Nothing secret is ever committed.
#
# Since v2 every integration is configured in the app: open /settings (or the first-run wizard
# at /setup) and paste values there. They are stored in SQLite, secrets encrypted with the key
# in DATA_DIR/secret.key, and take effect without a restart. Everything below the "core" block
# is an OPTIONAL FALLBACK: a variable is read only when nothing is saved in Settings, and the
# Settings page shows it with the source "env". New installs need none of them.
#
# Server reads these on start; the display needs none (it talks to the server same-origin).

# ---- core (scaffold) ----
# 1 = serve fixture data for every integration; no real accounts needed.
MOCK=1
# With MOCK: answer as a fresh install with nothing connected, to see the empty states.
# MOCK_EMPTY=1
PORT=8787
HOST=0.0.0.0
# SQLite and caches. ":memory:" keeps nothing.
DATA_DIR=./data
# How the tablet reaches the server; used to build OAuth redirect URLs.
PUBLIC_URL=http://localhost:8787
# Household timezone for the server process.
TZ=America/Los_Angeles
LOG_LEVEL=info
# Built display to serve at / (set in the Docker image; leave unset for `pnpm dev`).
# DISPLAY_DIST=../display/dist

# ---- WS2 calendars (setup guide: docs/calendars.md; setup page: /api/calendar/setup) ----
# OAuth client of type "Web application" from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to $PUBLIC_URL/api/calendar/google/callback when PUBLIC_URL is https or
# localhost, else http://localhost:$PORT/api/calendar/google/callback with a paste-back step.
# GOOGLE_REDIRECT_URI=
ICLOUD_USERNAME=
# App-specific password from appleid.apple.com.
ICLOUD_APP_PASSWORD=
# Optional tuning: seconds between syncs, and the cached window in days.
# CALENDAR_POLL_SECONDS=180
# CALENDAR_PUSH_POLL_SECONDS=900
# CALENDAR_PAST_DAYS=62
# CALENDAR_FUTURE_DAYS=366

# ---- WS3 Home Assistant (set up on the Settings page; these are optional fallbacks) ----
# As the server sees it. With both containers on Unraid, the host's IP and port 8123.
# Used until an address is saved in Settings > Home Assistant.
HA_URL=http://homeassistant.local:8123
# Long-lived access token: HA > your profile > Security > Long-lived access tokens.
# Used until a token is saved in Settings.
HA_TOKEN=
# A home.yaml to import once when the database has no rooms yet (config/home.example.yaml
# shows the shape). After that the rooms live in the database and this file is not read.
HA_ALLOWLIST=./config/home.yaml
# Hard cap on one live camera view, in seconds (the display closes it sooner).
HA_STREAM_MAX_SECONDS=120

# ---- weather quips (optional) ----
# Claude API key for a freshly written weather line each day; without it the built-in library is used.
CLAUDE_API_KEY=

# ---- WS4 weather, commute, photos (see docs/weather-commute-photos.md) ----
# Weather needs no key: Open-Meteo for the forecast and air quality, api.weather.gov for alerts.
# Leave-by times need no key: OpenStreetMap (Nominatim + OSRM) gives typical drive times.
# A Google Maps Platform key with the Routes API enabled adds live traffic.
GOOGLE_ROUTES_API_KEY=
# Optional free OpenRouteService key, used instead of OSRM when there is no Google key.
# OPENROUTESERVICE_API_KEY=
# Your own OSRM server instead of the public demo server.
# OSRM_BASE_URL=https://router.project-osrm.org
# Optional key for the Google Pollen API (pollen outside Europe). Defaults to the Routes key.
GOOGLE_POLLEN_API_KEY=
# Public link of an iCloud Shared Album with "Public Website" on. Unset: no photos.
ICLOUD_SHARED_ALBUM_URL=
# Most photos to keep from the album, newest first.
PHOTO_LIMIT=500
# Contact (email or URL) in the User-Agent for NWS and Nominatim; defaults to this repo's URL.
NWS_CONTACT=
